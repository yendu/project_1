{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "import", "promise", "node", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "options": {
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "warn"
  },
  "ignorePatterns": ["**/dist/**", "**/coverage/**"]
}
