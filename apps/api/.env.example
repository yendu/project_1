# Copy to apps/api/.env for local development. Never commit .env.
NODE_ENV=development
PORT=3000
# fatal, error, warn, info, debug, trace or silent
LOG_LEVEL=info
# Comma-separated exact origins allowed to call the API from a browser (e.g. the dashboard).
# Empty means no cross-origin access. Example: http://localhost:3001
CORS_ORIGINS=
# Local PostgreSQL from `pnpm db:up` (docker-compose.yml). Required.
DATABASE_URL=postgres://food_delivery:food_delivery@localhost:5432/food_delivery
# Connections per API process (1-100).
DATABASE_POOL_MAX=10
# Firebase project that issues Google sign-in tokens. Required, but not a secret.
# Replace this placeholder with your real project ID before signing in for real.
FIREBASE_PROJECT_ID=demo-food-delivery
# The first admin: this Google address becomes an admin on first sign-in. Optional.
# ADMIN_EMAIL=you@gmail.com
