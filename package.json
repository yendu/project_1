{
  "name": "food-delivery",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "pnpm --filter @food-delivery/api dev",
    "build": "pnpm -r build",
    "lint": "oxlint && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "db:up": "docker compose up --detach --wait postgres",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @food-delivery/api db:generate",
    "db:migrate": "pnpm --filter @food-delivery/api db:migrate"
  },
  "devDependencies": {
    "oxlint": "^1.90.0",
    "prettier": "^3.9.10"
  }
}
